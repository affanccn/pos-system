datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MANAGER
  WAITER
  KITCHEN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILL_REQUESTED
}

enum OrderStatus {
  CONFIRMED
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum StationType {
  KITCHEN
  BAR
  SHISHA // Nargile istasyonu eklendi
  DESSERT
  COFFEE
}

enum PrinterConnectionType {
  ETHERNET
  USB
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
  VOID
  COMPLIMENTARY
  RETURNED
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
  ACCOUNT
}

model Business {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @db.VarChar(100)
  slug     String  @unique @db.VarChar(100)
  currency String  @default("TRY") @db.VarChar(3)
  isActive Boolean @default(true) @map("is_active")

  // WINDOWS KASA KİLİDİ VE GÜN DURUMU ALANLARI
  isDayOpen       Boolean   @default(false) @map("is_day_open")
  dayOpenedAt     DateTime? @map("day_opened_at")
  isWindowsOnline Boolean   @default(false) @map("is_windows_online")
  windowsSocketId String?   @map("windows_socket_id") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           User[]
  tables          RestaurantTable[]
  categories      Category[]
  products        Product[]
  orders          Order[]
  payments        Payment[]
  auditLogs       AuditLog[]
  printers        Printer[]
  stockItems      StockItem[]
  expenses        Expense[]
  cashMovements   CashRegisterMovement[]
  reservations    Reservation[]
  endOfDayReports EndOfDayReport[]
  receiptTemplate ReceiptTemplate?

  @@map("businesses")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  fullName          String   @map("full_name") @db.VarChar(100)
  pinCodeHash       String   @map("pin_code_hash") @db.VarChar(255)
  email             String?  @db.VarChar(150)
  role              Role     @default(WAITER)
  customPermissions String[] @default([]) @map("custom_permissions")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  business      Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders        Order[]                @relation("WaiterOrders")
  payments      Payment[]              @relation("CashierPayments")
  auditLogs     AuditLog[]
  expenses      Expense[]              @relation("UserExpenses")
  cashMovements CashRegisterMovement[] @relation("UserCashMovements")
  closedDays    EndOfDayReport[]

  @@unique([businessId, email])
  @@index([businessId, role])
  @@map("users")
}

model RestaurantTable {
  id             String      @id @default(uuid()) @db.Uuid
  businessId     String      @map("business_id") @db.Uuid
  name           String      @db.VarChar(50)
  section        String      @default("Salon") @db.VarChar(50)
  capacity       Int         @default(4)
  status         TableStatus @default(AVAILABLE)
  currentOrderId String?     @unique @map("current_order_id") @db.Uuid
  sortOrder      Int         @default(0) @map("sort_order")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currentOrder Order?        @relation("ActiveTableOrder", fields: [currentOrderId], references: [id], onDelete: SetNull)
  orders       Order[]       @relation("TableOrderHistory")
  reservations Reservation[]

  @@unique([businessId, name])
  @@index([businessId, status])
  @@map("restaurant_tables")
}

model Category {
  id          String      @id @default(uuid()) @db.Uuid
  businessId  String      @map("business_id") @db.Uuid
  name        String      @db.VarChar(100)
  stationType StationType @default(KITCHEN) @map("station_type")
  printerId   String?     @map("printer_id") @db.Uuid // Kategoriyi doğrudan Bar/Mutfak/Nargile yazıcısına bağlar
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  printer  Printer?  @relation("CategoryPrinter", fields: [printerId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([businessId, isActive])
  @@map("categories")
}

model Product {
  id          String       @id @default(uuid()) @db.Uuid
  businessId  String       @map("business_id") @db.Uuid
  categoryId  String       @map("category_id") @db.Uuid
  name        String       @db.VarChar(120)
  priceCents  Int          @map("price_cents")
  description String?      @db.VarChar(255)
  taxRate     Int          @default(0) @map("tax_rate")
  costCents   Int          @default(0) @map("cost_cents")
  stationType StationType? @map("station_type")
  imageUrl    String?      @map("image_url") @db.VarChar(500)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  business       Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  modifierGroups ProductModifierGroup[]
  recipeItems    ProductRecipeItem[]

  @@index([businessId, categoryId, isActive])
  @@map("products")
}

model Order {
  id                  String      @id @default(uuid()) @db.Uuid
  businessId          String      @map("business_id") @db.Uuid
  tableId             String      @map("table_id") @db.Uuid
  waiterId            String      @map("waiter_id") @db.Uuid
  orderNumber         Int         @map("order_number")
  status              OrderStatus @default(CONFIRMED)
  totalAmountCents    Int         @default(0) @map("total_amount_cents")
  paidAmountCents     Int         @default(0) @map("paid_amount_cents")
  discountAmountCents Int         @default(0) @map("discount_amount_cents")
  notes               String?     @db.VarChar(255)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table          RestaurantTable  @relation("TableOrderHistory", fields: [tableId], references: [id], onDelete: Restrict)
  activeForTable RestaurantTable? @relation("ActiveTableOrder")
  waiter         User             @relation("WaiterOrders", fields: [waiterId], references: [id])
  items          OrderItem[]
  payments       Payment[]

  @@index([businessId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  productId           String          @map("product_id") @db.Uuid
  productNameSnapshot String          @map("product_name_snapshot") @db.VarChar(120)
  unitPriceCents      Int             @map("unit_price_cents")
  quantity            Int             @default(1)
  paidQuantity        Int             @default(0) @map("paid_quantity")
  totalPriceCents     Int             @map("total_price_cents")
  discountAmountCents Int             @default(0) @map("discount_amount_cents")
  status              OrderItemStatus @default(PENDING)
  notes               String?         @db.VarChar(150)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifiers OrderItemModifier[]

  @@index([orderId, status])
  @@map("order_items")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  cashierId       String        @map("cashier_id") @db.Uuid
  method          PaymentMethod
  amountCents     Int           @map("amount_cents")
  cashAmountCents Int           @default(0) @map("cash_amount_cents")
  cardAmountCents Int           @default(0) @map("card_amount_cents")
  createdAt       DateTime      @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cashier  User     @relation("CashierPayments", fields: [cashierId], references: [id])

  @@index([businessId, createdAt])
  @@map("payments")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entity      String?  @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  description String?  @db.VarChar(500)
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([businessId, action])
  @@index([businessId, entity, entityId])
  @@map("audit_logs")
}

model ProductModifierGroup {
  id          String      @id @default(uuid()) @db.Uuid
  productId   String      @map("product_id") @db.Uuid
  name        String      @db.VarChar(100)
  stationType StationType @default(KITCHEN) @map("station_type")
  isRequired  Boolean     @default(false) @map("is_required")
  minSelect   Int         @default(0) @map("min_select")
  maxSelect   Int         @default(1) @map("max_select")
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  product Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   ProductModifierItem[]

  @@index([productId, isActive])
  @@map("product_modifier_groups")
}

model ProductModifierItem {
  id              String      @id @default(uuid()) @db.Uuid
  modifierGroupId String      @map("modifier_group_id") @db.Uuid
  name            String      @db.VarChar(100)
  stationType     StationType @default(KITCHEN) @map("station_type")
  priceCents      Int         @default(0) @map("price_cents")
  sortOrder       Int         @default(0) @map("sort_order")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  modifierGroup      ProductModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@index([modifierGroupId, isActive])
  @@map("product_modifier_items")
}

model OrderItemModifier {
  id                   String @id @default(uuid()) @db.Uuid
  orderItemId          String @map("order_item_id") @db.Uuid
  modifierItemId       String @map("modifier_item_id") @db.Uuid
  modifierNameSnapshot String @map("modifier_name_snapshot") @db.VarChar(100)
  priceCentsSnapshot   Int    @map("price_cents_snapshot")
  quantity             Int    @default(1)
  totalPriceCents      Int    @map("total_price_cents")

  orderItem    OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierItem ProductModifierItem @relation(fields: [modifierItemId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model Printer {
  id             String                @id @default(uuid()) @db.Uuid
  businessId     String                @map("business_id") @db.Uuid
  name           String                @db.VarChar(100) // Örn: "Bar & Kasa", "Mutfak", "Nargile"
  connectionType PrinterConnectionType @default(ETHERNET) @map("connection_type")
  ipAddress      String                @map("ip_address") @db.VarChar(100) // IP adresi veya Windows USB Yazıcı Adı
  port           Int                   @default(9100)
  stationType    StationType?          @map("station_type")
  isCashier      Boolean               @default(false) @map("is_cashier") // TRUE ise Hesap & Z Raporu buradan çıkar (Bar Yazıcısı)
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categories Category[] @relation("CategoryPrinter")

  @@index([businessId, isActive])
  @@map("printers")
}

// YENİ: FİŞ TASARIM STÜDYOSU TABLOSU (Hesap Fişi + Mutfak/Bar/Nargile Sipariş Fişi)
model ReceiptTemplate {
  id         String @id @default(uuid()) @db.Uuid
  businessId String @unique @map("business_id") @db.Uuid

  // 1. Müşteri Hesap (Adisyon) Fişi Tasarımı
  headerTitle    String  @default("ARTISAN POS") @map("header_title") @db.VarChar(100)
  headerSubtitle String? @default("Cafe & Restaurant") @map("header_subtitle") @db.VarChar(150)
  address        String? @db.VarChar(250)
  phone          String? @db.VarChar(50)
  wifiInfo       String? @map("wifi_info") @db.VarChar(150)
  footerMessage  String? @default("Bizi tercih ettiğiniz için teşekkür ederiz!") @map("footer_message") @db.VarChar(250)
  showLogo       Boolean @default(true) @map("show_logo")
  showWaiterName Boolean @default(true) @map("show_waiter_name")
  showTaxDetails Boolean @default(false) @map("show_tax_details")
  paperWidthMm   Int     @default(80) @map("paper_width_mm") // 80 veya 58

  // 2. Mutfak / Bar / Nargile (Sipariş) Fişi Tasarımı
  orderTableFontSize String  @default("2X") @map("order_table_font_size") @db.VarChar(20) // NORMAL, LARGE, 2X
  orderItemFontSize  String  @default("LARGE") @map("order_item_font_size") @db.VarChar(20) // NORMAL, BOLD, LARGE
  highlightNotes     Boolean @default(true) @map("highlight_notes")
  buzzerBeep         Boolean @default(true) @map("buzzer_beep")

  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("receipt_templates")
}

model StockItem {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  name          String   @db.VarChar(100)
  unit          String   @db.VarChar(20)
  currentAmount Float    @default(0) @map("current_amount")
  minAmount     Float    @default(0) @map("min_amount")
  unitCostCents Int      @default(0) @map("unit_cost_cents")
  supplier      String?  @db.VarChar(150)
  isCritical    Boolean  @default(false) @map("is_critical")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipeItems ProductRecipeItem[]

  @@index([businessId, isActive])
  @@map("stock_items")
}

model ProductRecipeItem {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  stockItemId     String   @map("stock_item_id") @db.Uuid
  quantity        Float
  wastePercentage Int      @default(0) @map("waste_percentage")
  costCents       Int      @default(0) @map("cost_cents")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([stockItemId])
  @@map("product_recipe_items")
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  WATER
  STAFF
  SUPPLIES
  MAINTENANCE
  MARKETING
  OTHER
}

enum CashMovementType {
  OPENING
  CASH_IN
  CASH_OUT
  EXPENSE
  CLOSING
}

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  businessId  String          @map("business_id") @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  category    ExpenseCategory @default(OTHER)
  amountCents Int             @map("amount_cents")
  description String?         @db.VarChar(500)
  expenseDate DateTime        @default(now()) @map("expense_date")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation("UserExpenses", fields: [userId], references: [id])

  @@index([businessId, expenseDate])
  @@index([businessId, category])
  @@map("expenses")
}

model CashRegisterMovement {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        CashMovementType
  amountCents Int              @map("amount_cents")
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation("UserCashMovements", fields: [userId], references: [id])

  @@index([businessId, createdAt])
  @@map("cash_register_movements")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  NO_SHOW
  CANCELLED
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  businessId      String            @map("business_id") @db.Uuid
  tableId         String?           @map("table_id") @db.Uuid
  customerName    String            @map("customer_name") @db.VarChar(100)
  customerPhone   String?           @map("customer_phone") @db.VarChar(20)
  reservationDate DateTime          @map("reservation_date")
  guestCount      Int               @default(1) @map("guest_count")
  status          ReservationStatus @default(PENDING)
  notes           String?           @db.VarChar(500)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table    RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([businessId, reservationDate])
  @@index([businessId, status])
  @@map("reservations")
}

model EndOfDayReport {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  closedById String   @map("closed_by_id") @db.Uuid
  reportDate DateTime @map("report_date") @db.Date

  totalSalesCents    Int @map("total_sales_cents")
  cashCents          Int @map("cash_cents")
  cardCents          Int @map("card_cents")
  discountCents      Int @map("discount_cents")
  complimentaryCents Int @map("complimentary_cents")
  returnedCents      Int @map("returned_cents")
  expensesCents      Int @map("expenses_cents")

  openingCashCents  Int @map("opening_cash_cents")
  expectedCashCents Int @map("expected_cash_cents")
  actualCashCents   Int @map("actual_cash_cents")
  differenceCents   Int @map("difference_cents")

  isClosed  Boolean  @default(true) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  closedBy User     @relation(fields: [closedById], references: [id], onDelete: Restrict)

  @@unique([businessId, reportDate])
  @@map("end_of_day_reports")
}